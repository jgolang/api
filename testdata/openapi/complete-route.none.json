{
  "openapi": "3.0.3",
  "info": {
    "title": "Tasks API",
    "version": "1.0.0"
  },
  "paths": {
    "/projects/{projectID}/tasks": {
      "post": {
        "operationId": "createTask",
        "summary": "Create a task",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "description": "Client request ID for tracing",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectID",
            "in": "path",
            "required": true,
            "description": "Project that owns the task",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "notify",
            "in": "query",
            "description": "Notify the project members",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectTaskRequest"
              },
              "example": {
                "title": "Write docs",
                "priority": "high"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "URL of the created task",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectTaskResponse"
                },
                "example": {
                  "id": 42,
                  "priority": "high",
                  "projectId": "7",
                  "title": "Write docs"
                }
              }
            }
          },
          "400": {
            "description": "The title is missing or the body is not valid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/projects/{projectID}/tasks/{taskID}": {
      "delete": {
        "operationId": "deleteTask",
        "summary": "Delete a task",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "projectID",
            "in": "path",
            "required": true,
            "description": "Project that owns the task",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "taskID",
            "in": "path",
            "required": true,
            "description": "Task to delete",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getTask",
        "summary": "Get a task",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "projectID",
            "in": "path",
            "required": true,
            "description": "Project that owns the task",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "taskID",
            "in": "path",
            "required": true,
            "description": "Task to return",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectTaskResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "enum": [
                    null
                  ],
                  "nullable": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateProjectTaskRequest": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "ProjectTaskResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "priority": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "projectId",
          "title"
        ]
      }
    }
  }
}
