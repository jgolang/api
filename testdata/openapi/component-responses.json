{
  "openapi": "3.0.3",
  "info": {
    "title": "Component responses API",
    "version": "1.0.0"
  },
  "paths": {
    "/tasks/{id}": {
      "delete": {
        "operationId": "deleteTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "$ref": "#/components/responses/TaskNotFound"
          }
        }
      },
      "get": {
        "operationId": "getTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "$ref": "#/components/responses/TaskNotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResponseInfo"
          }
        },
        "required": [
          "header"
        ]
      },
      "ResponseInfo": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "example": "refresh"
          },
          "code": {
            "type": "string",
            "description": "0000 by default on success; on an error, the error's code, such as E001 or TSK-404.",
            "example": "0000"
          },
          "event_id": {
            "type": "string",
            "example": "f716243f2c92df55fcd8f67018b1dcfb"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "field": "value"
            }
          },
          "message": {
            "type": "string",
            "example": "Operation completed"
          },
          "title": {
            "type": "string",
            "example": "Success"
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
          },
          "type": {
            "type": "string",
            "example": "success"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "responses": {
      "TaskNotFound": {
        "description": "Task not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
