                {
                  "$ref": "#/components/schemas/RefAssignee"
                }
              ]
            }
          }
        },
        "required": [
          "kind",
          "reviewer",
          "sample",
          "creator"
        ]
      },
      "SchemaAddress": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      },
      "SchemaExample": {
        "type": "object",
        "properties": {
          "address": {
            "nullable": true,
