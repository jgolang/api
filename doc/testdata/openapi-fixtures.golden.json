      "TestRequestOfCreateTaskRequest": {
        "type": "object",
        "properties": {
          "content": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateTaskRequest"
              }
            ]
          },
          "header": {
            "$ref": "#/components/schemas/TestRequestInfo"
          }
        }
      },
      "TestResponseInfo": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "success"
          }
        },
        "required": [
          "type"
        ]
      },
      "TestResponseOfArrayOfTaskResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            },
            "nullable": true
          },
          "header": {
            "$ref": "#/components/schemas/TestResponseInfo"
          }
        }
      },
      "TestResponseOfTaskResponse": {
        "type": "object",
        "properties": {
          "content": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskResponse"
              }
            ]
          },
          "header": {
            "$ref": "#/components/schemas/TestResponseInfo"
          }
        }
      }
    }
  }
