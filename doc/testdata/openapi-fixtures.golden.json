        "required": [
          "title"
        ]
      },
      "RefAssignee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id"
        ]
      },
      "RefBase": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      },
      "RefTaskRequest": {
        "type": "object",
        "properties": {
          "creator": {
            "$ref": "#/components/schemas/RefAssignee"
          },
          "kind": {
            "type": "string"
          },
          "owner": {
            "description": "Optional owner",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/RefAssignee"
              }
            ]
          },
          "reviewer": {
            "description": "Reviewer",
            "allOf": [
              {
                "$ref": "#/components/schemas/RefAssignee"
              }
            ]
          },
          "sample": {
            "example": {
              "id": 7
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/RefAssignee"
              }
            ]
          },
          "watchers": {
            "type": "array",
            "items": {
              "nullable": true,
